# Copy this file to .env and paste your key from https://developer.clashroyale.com
# (.env is git-ignored, so the key never gets committed)
CR_API_TOKEN=paste-your-token-here

# Optional. Supercell keys only work from the IP address you registered.
# If your home IP changes often, register the key for 45.79.218.79 and use the
# RoyaleAPI proxy instead by uncommenting the next line.
# CR_API_BASE=https://proxy.royaleapi.dev/v1

# Your own player tag, used as a crawl seed (with or without the #)
CR_SEED_TAGS=
